pipeline {
    agent any

    environment {
        IMAGE_NAME = 'gestion-income-pdn'
        IMAGE_TAG = 'latest'
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out code...'
                checkout scm
            }
        }

        stage('Build Application') {
            steps {
                echo 'Building Spring Boot Income Service PDN...'
                dir('Back/ms_income') {
                    sh 'chmod +x ./mvnw'
                    sh './mvnw clean package -DskipTests'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                echo 'Building Docker image...'
                dir('Back/ms_income') {
                    sh 'docker build -t ${IMAGE_NAME}:${IMAGE_TAG} .'
                }
            }
        }

        stage('Deploy Application') {
            steps {
                echo 'Deploying Income Service PDN...'
                sh '''
                    docker network create gestios-gastos-back-pdn || true
                    
                    docker stop msincome-pdn || true
                    docker rm msincome-pdn || true

                    docker run -d \
                      --name msincome-pdn \
                      --network gestios-gastos-back-pdn \
                      -p 8100:8100 \
                      -e SPRING_PROFILES_ACTIVE=pdn \
                      -e SPRING_DATASOURCE_URL="jdbc:postgresql://DataBase-pdn:5432/gestion_gastos_pdn" \
                      -e SPRING_DATASOURCE_USERNAME=postgres \
                      -e SPRING_DATASOURCE_PASSWORD=pdn123456 \
                      -e CATEGORIES_SERVICE_URL=http://mscategories-pdn:8090 \
                      ${IMAGE_NAME}:${IMAGE_TAG}
                    
                    sleep 10
                    if docker ps | grep msincome-pdn; then
                        echo "✅ Income Service PDN running on port 8100"
                    else
                        echo "❌ Failed to start Income Service PDN"
                        docker logs msincome-pdn || true
                        exit 1
                    fi
                '''
            }
        }
    }

    post {
        always {
            echo '✅ Pipeline completed'
        }
    }
}