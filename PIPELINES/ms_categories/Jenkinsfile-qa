pipeline {
    agent any

    environment {
        IMAGE_NAME = 'gestion-categories-qa'
        IMAGE_TAG = 'latest'
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out code...'
                checkout scm
            }
        }

        stage('Build Application') {
            steps {
                echo 'Building Spring Boot Categories Service QA...'
                dir('Back/ms_categories') {
                    sh 'chmod +x ./mvnw'
                    sh './mvnw clean package -DskipTests'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                echo 'Building Docker image...'
                dir('Back/ms_categories') {
                    sh 'docker build -t ${IMAGE_NAME}:${IMAGE_TAG} .'
                }
            }
        }

        stage('Deploy Application') {
            steps {
                echo 'Deploying Categories Service QA...'
                sh '''
                    docker network create gestios-gastos-back-qa || true
                    
                    docker stop mscategories-qa || true
                    docker rm mscategories-qa || true

                    docker run -d \
                      --name mscategories-qa \
                      --network gestios-gastos-back-qa \
                      -p 8111:8090 \
                      -e SPRING_PROFILES_ACTIVE=qa \
                      -e SPRING_DATASOURCE_URL="jdbc:postgresql://DataBase-qa:5432/gestion_gastos_qa" \
                      -e SPRING_DATASOURCE_USERNAME=postgres \
                      -e SPRING_DATASOURCE_PASSWORD=qa123456 \
                      ${IMAGE_NAME}:${IMAGE_TAG}
                    
                    sleep 10
                    if docker ps | grep mscategories-qa; then
                        echo "✅ Categories Service QA running on port 8111"
                    else
                        echo "❌ Failed to start Categories Service QA"
                        docker logs mscategories-qa || true
                        exit 1
                    fi
                '''
            }
        }
    }

    post {
        always {
            echo '✅ Pipeline completed'
        }
    }
}